* text=auto

# Shell scripts must stay LF or they fail on every Unix agent with
# "$'\r': command not found".
*.sh    text eol=lf
*.mjs   text eol=lf
*.ts    text eol=lf
*.astro text eol=lf
*.css   text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.yml   text eol=lf

# PowerShell is happiest with CRLF on Windows 5.1.
*.ps1   text eol=crlf
*.cmd   text eol=crlf
